# Backend runtime
APP_ENV=production
DEBUG=false
AI_MODE=mock
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-project.vercel.app
REQUEST_TIMEOUT_SECONDS=20

# Required only when AI_MODE=live. Store these in Vercel environment variables.
GEMINI_API_KEY=replace-with-server-side-secret
GEMINI_MODEL=gemini-2.5-flash
YOUCAM_API_KEY=replace-with-server-side-secret
YOUCAM_CLOTHES_TRYON_URL=https://api.example.com/s2s/v2.1/task/cloth
YOUCAM_AUTH_HEADER=X-API-KEY
YOUCAM_AUTH_PREFIX=
